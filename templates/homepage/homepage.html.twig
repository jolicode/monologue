{% extends 'base.html.twig' %}

{% block title %}Monologue{% endblock %}

{% block body %}
    <header class="header">
        <div class="header__inner">
            <h1 class="brand">
                <span class="brand__logo" aria-hidden="true">🥐</span>
                Monologue
            </h1>
            <p class="header__tagline">One person per day. The others bring breakfast.</p>
        </div>
    </header>

    <main class="layout">
        <section class="panel">
            <header class="panel__header">
                <h2 class="panel__title">
                    Events
                    <span class="badge">{{ events|length }}</span>
                </h2>
                <nav class="date-nav" aria-label="Change day">
                    <a class="date-nav__button" href="{{ url('homepage', {date: date.modify('-1 day').format('Y-m-d')}) }}" aria-label="Previous day">‹</a>
                    <time class="date-nav__current" datetime="{{ date|date('Y-m-d') }}">{{ date|date('D j M Y') }}</time>
                    <a class="date-nav__button" href="{{ url('homepage', {date: date.modify('+1 day').format('Y-m-d')}) }}" aria-label="Next day">›</a>
                    {% if date|date('Y-m-d') != 'now'|date('Y-m-d') %}
                        <a class="date-nav__today" href="{{ url('homepage') }}">Today</a>
                    {% endif %}
                </nav>
            </header>

            {% if events is empty %}
                <p class="empty">
                    <span class="empty__icon" aria-hidden="true">🤫</span>
                    Nothing was said this day.
                </p>
            {% else %}
                <ol class="feed">
                    {% for event in events %}
                        <li class="feed__item">
                            <div class="feed__body">
                                <div class="feed__meta">
                                    <code class="user">{{ event.author }}</code>
                                    <time class="feed__time" datetime="{{ event.createdAt|date('c') }}">{{ event.createdAt|date('H:i:s') }}</time>
                                </div>
                                <p class="feed__content">{{ event.content }}</p>
                            </div>
                        </li>
                    {% endfor %}
                </ol>
            {% endif %}
        </section>

        <section class="panel">
            <header class="panel__header">
                <h2 class="panel__title">
                    Pending debts
                    <span class="badge{{ debts is not empty ? ' badge--warning' }}">{{ debts|length }}</span>
                </h2>
            </header>

            {% if debts is empty %}
                <p class="empty">
                    <span class="empty__icon" aria-hidden="true">🎉</span>
                    Everyone is clear. No breakfast owed!
                </p>
            {% else %}
                <ul class="debts">
                    {% for debt in debts %}
                        <li class="debt">
                            <div class="debt__header">
                                <code class="user user--warning">{{ debt.author }}</code>
                                <time class="debt__date" datetime="{{ debt.createdAt|date('Y-m-d') }}">{{ debt.createdAt|date('D j M Y') }}</time>
                            </div>
                            <dl class="debt__details">
                                <dt>Said</dt>
                                <dd>{{ debt.event.content }}</dd>
                                <dt>After</dt>
                                <dd><code class="user">{{ debt.cause.author }}</code> {{ debt.cause.content }}</dd>
                            </dl>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </main>
{% endblock %}
